# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=""

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Razorpay ---
# Get keys from https://dashboard.razorpay.com/app/keys (use TEST mode keys in development)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From Razorpay Dashboard > Settings > Webhooks, when you configure the webhook URL
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID, exposed to the browser for Checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=""

# --- Image storage (production only) ---
# Set automatically by Vercel when you attach a Blob store to the project (Storage tab).
# Leave empty for local dev — uploads fall back to the local disk (public/uploads).
BLOB_READ_WRITE_TOKEN=""
